interface Command {
    name: string
    execute(player: Player): void
}

class Player {
    name: string
    health: number = 100

    constructor = function (name: string)
        self.name = name
    end

    takeDamage = function (amount: number): void
        self.health -= amount
    end

    describe = function (): string
        return self.name
    end
}

class VIPPlayer extends Player {
    level: number = 1

    constructor = function (name: string, level: number)
        self:super(name)
        self.level = level
    end

    takeDamage = function (amount: number): void
        self:super(amount / 2)
    end
}

class KickCommand implements Command {
    name: string = 'kick'

    execute = function (player: Player): void
        print(player.name)
    end
}

local vip = new VIPPlayer('Thigas', 2)

vip:takeDamage(20)

print(vip.name, vip.health)
