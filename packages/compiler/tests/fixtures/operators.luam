--!strict
local base: number = 1 + 2 - 3 * 4 / 5 % 6 ^ 2
local negated: number = -base
local joined: string = 'x' .. 'y' .. 'z'
local length: number = #joined
local equal: boolean = base == 2
local different: boolean = base ~= 2
local ranged: boolean = base < 2 and base > 0
local inverted: boolean = not equal
local bounded: boolean = base <= 2 or base >= 0
local grouped: number = (1 + 2) * 3
local powered: number = 2 ^ 3 ^ 2
local counter: number = 0
local slots: number[] = { 1, 2 }

counter++
counter--
counter-- -- back to zero
slots[1]++

print(counter, slots)
print(base, negated, joined, length, equal, different)
print(ranged, inverted, bounded, grouped, powered)
