#!strict
type PlayerId = number
type Nullable<T> = T | nil

local id: PlayerId = 7
local maybe: Nullable<string> = nil
local label: string | number = 'label'
local optional?: string = nil
local names: string[] = { 'a', 'b' }
local matrix: number[][] = {}
local callback: fun(string): void = print
local reducer: fun(total: number, value: number): number = function (total: number, value: number): number
    return total + value
end
local logger: fun(...): void = print
local wrapped?: fun(string): void = nil
local loose: fun = print

local function identity(value: number): number
    return value
end

print(id, maybe, label, optional, names, matrix, callback, reducer, logger, wrapped, loose, identity(1))
