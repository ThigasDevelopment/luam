{
    info = {
        author = { name = 'Luam' },

        version = '1.0.0',
        description = 'A request and response bus that crosses an event with a promise.',
    },

    environment = {
        oop = false,
        strict = true,
    },

    scripts = {
        { path = 'src/shared/**/*.luam', type = 'shared' },

        { path = 'src/server/**/*.luam', type = 'server' },
        { path = 'src/client/**/*.luam', type = 'client' },
    },

    build = {
        details = {
            bundle = false,
            map = true,
        },
    },
}
