// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`resource assembly > generates a manifest that matches the authored standard 1`] = `
"<meta>
    <!-- Resource information -->
    <info author="Thigas" type="script" version="1.0.0" />
    <!-- Runtime library -->
    <script src="lib/class.lua" type="shared" cache="false" />
    <script src="lib/string.lua" type="client" cache="false" />
    <script src="lib/table.lua" type="shared" cache="false" />
    <!-- Source scripts -->
    <script src="src/shared/**/*.lua" type="shared" cache="false" />
    <script src="src/server/**/*.lua" />
    <script src="src/client/**/*.lua" type="client" cache="false" />
</meta>
"
`;

exports[`resource assembly > locks the generated resource output 1`] = `
[
  "src/shared/config.lua
RESOURCE_NAME = 'luam-demo'
GameState = enum { 'LOBBY', 'PLAYING' }
local state = GameState.LOBBY
function formatPlayerName(name)
    return 'Player: ' .. name
end
function countEntries(entries)
    return table.size(entries)
end
",
  "src/server/main.lua
local joined = 0
class 'Session' {
    name = '',
    constructor = function(self, name)
        self.name = name
    end
}
function announceJoin(player)
    joined = joined + 1
    local session = new 'Session' (getPlayerName(player))
    outputChatBox(formatPlayerName(session.name), root)
    outputChatBox(RESOURCE_NAME, root)
end
addEventHandler('onPlayerJoin', root, function()
    announceJoin(source)
end)
",
  "src/client/hud.lua
local title = 'Luam'
local caption = string.template('HUD \${title}', { title = title })
addEventHandler('onClientRender', root, function()
    dxDrawText(caption, 10, 10)
end)
",
]
`;
