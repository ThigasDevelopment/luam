exports[`fixture classes.luam > locks the generated Lua 5.1 output 1`] = `
"class 'Player' {
    health = 100,
    constructor = function(self, name)
        self.name = name
    end,
    takeDamage = function(self, amount)
        self.health = self.health - amount
    end,
    describe = function(self)
        return self.name
    end
}
class 'VIPPlayer' :extends 'Player' {
    level = 1,
    constructor = function(self, name, level)
        self:super(name)
        self.level = level
    end,
    takeDamage = function(self, amount)
        self:super(amount / 2)
    end
}
class 'KickCommand' {
    name = 'kick',
    execute = function(self, player)
        print(player.name)
    end
}
local vip = new 'VIPPlayer' ('Thigas', 2)
vip:takeDamage(20)
print(vip.name, vip.health)
"
`;

