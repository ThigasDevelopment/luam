"class 'Player' {
    name = 'Luam',
    admin = false,
    getName = function(self)
        return self.name
    end,
    setName = function(self, value)
        self.name = value
    end,
    isAdmin = function(self)
        return self.admin
    end,
    setAdmin = function(self, value)
        self.admin = value
    end
}
local player = new 'Player' ()
player:setName('Compiler')
local name = player:getName()
local admin = player:isAdmin()
print(name, admin)
"
`;

