exports[`fixture annotations.luam > locks the generated Lua 5.1 output 1`] = `
"local id = 7
local maybe = nil
local label = 'label'
local optional = nil
local names = { 'a', 'b' }
local matrix = {}
local callback = print
local reducer = function(total, value)
    return total + value
end
local logger = print
local wrapped = nil
local loose = print
local function identity(value)
    return value
end
print(id, maybe, label, optional, names, matrix, callback, reducer, logger, wrapped, loose, identity(1))
"
`;

