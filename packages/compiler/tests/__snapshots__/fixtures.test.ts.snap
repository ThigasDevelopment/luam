exports[`fixture operators.luam > locks the generated Lua 5.1 output 1`] = `
"local base = 1 + 2 - 3 * 4 / 5 % 6 ^ 2
local negated = -base
local joined = 'x' .. 'y' .. 'z'
local length = #joined
local equal = base == 2
local different = base ~= 2
local ranged = base < 2 and base > 0
local inverted = not equal
local bounded = base <= 2 or base >= 0
local grouped = (1 + 2) * 3
local powered = 2 ^ 3 ^ 2
local counter = 0
local slots = { 1, 2 }
counter = counter + 1
counter = counter - 1
counter = counter - 1
slots[1] = slots[1] + 1
print(counter, slots)
print(base, negated, joined, length, equal, different)
print(ranged, inverted, bounded, grouped, powered)
"
`;

