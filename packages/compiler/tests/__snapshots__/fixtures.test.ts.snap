exports[`fixture templates.luam > locks the generated Lua 5.1 output 1`] = `
"local name = 'Thigas'
local user = { name = 'Thigas' }
local plain = 'no interpolation here'
local greeting = string.template('Ola \${name}, bem-vindo(a) novamente!', { name = name })
local fallback = string.template('Ola \${name:Guest}!', { name = name })
local nested = string.template('Bem-vindo \${user.name}', { user = user })
print(plain, greeting, fallback, nested)
"
`;

