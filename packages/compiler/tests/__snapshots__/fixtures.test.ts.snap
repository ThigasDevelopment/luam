local escaped = 'line\\nbreak'
local quoted = 'double'
local raw = 'long bracket'
local count = 42
local ratio = 1.5
local scientific = 2e3
local hex = 0xFF
local enabled = true
local disabled = false
local missing = nil
local list = { 1, 2, 3 }
local record = { name = 'a', [1] = 'b' }
print(name, escaped, quoted, raw, count, ratio, scientific, hex)
print(enabled, disabled, missing, list, record)
"
`;

