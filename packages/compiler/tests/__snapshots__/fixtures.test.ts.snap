exports[`fixture extensions.luam > locks the generated Lua 5.1 output 1`] = `
"local items = { 'a', 'b' }
local label = '  spaced  '
local lookup = {}
local ratio = -1.75
print(table.size(items))
print(table.isEmpty(items))
print(table.keys(lookup))
print(table.values(lookup))
print(table.includes(items, 'a'))
print(string.trim(label))
print(string.startsWith(label, '  '))
print(string.endsWith(label, '  '))
print(string.len(label))
print(string.upper(label))
print(string.lower(label))
print(math.abs(ratio))
print(math.floor(ratio))
print(math.ceil(ratio))
print(math.max(ratio, 2))
print(math.min(ratio, 2))
print(math.clamp(ratio, 0, 1))
print(lookup['count'])
"
`;

