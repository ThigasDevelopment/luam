exports[`fixture control-flow.luam > locks the generated Lua 5.1 output 1`] = `
"local total = 0
for index = 1, 10 do
    total = total + index
end
for step = 10, 1, -1 do
    total = total - step
end
for key, value in pairs({ a = 1 }) do
    print(key, value)
end
while total > 0 do
    total = total - 1
end
repeat
    total = total + 1
until total >= 10
do
    local scoped = 'inner'
    print(scoped)
end
if total > 5 then
    print('high')
elseif total > 2 then
    print('medium')
else
    print('low')
end
for index = 1, 3 do
    if index == 2 then
        break
    end
end
"
`;

