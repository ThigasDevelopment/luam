exports[`fixture functions.luam > locks the generated Lua 5.1 output 1`] = `
"function greet(name, tag)
    if tag ~= nil then
        return name .. ' (' .. tostring(tag) .. ')'
    end
    return name
end
local function double(value)
    return value * 2
end
local anonymous = function(...)
    print(...)
end
local player = {}
function player.describe()
    print('player')
end
function player:rename(name)
    print(name)
end
anonymous(greet('Thigas'), double(2))
player:rename('Thigas')
"
`;

