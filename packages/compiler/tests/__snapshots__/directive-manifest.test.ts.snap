// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`directive manifest > locks the manifest for a project using every directive 1`] = `
"<directives>
    <!-- INFO -->
    <info type="script" />
    <!-- SCRIPTS -->
    <script src="src/shared/**/*.lua" type="shared" cache="false" />
    <script src="src/server/**/*.lua" />
    <script src="src/client/**/*.lua" type="client" cache="false" />
    <!-- FILES -->
    <file src="assets/logo.png" />
    <!-- EXPORTS -->
    <export function="formatScore" type="shared" http="false" />

    <export function="getScore" http="false" />

    <export function="refreshHud" type="client" http="false" />
</directives>
"
`;
