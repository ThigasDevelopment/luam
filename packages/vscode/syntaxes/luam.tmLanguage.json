{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Luam",
    "scopeName": "source.luam",
    "patterns": [
        { "include": "#directive" },
        { "include": "#decorator" },
        { "include": "#decrement" },
        { "include": "#comment" },
        { "include": "#string" },
        { "include": "#number" },
        { "include": "#buildDirective" },
        { "include": "#enumBody" },
        { "include": "#declaration" },
        { "include": "#field" },
        { "include": "#function" },
        { "include": "#method" },
        { "include": "#annotation" },
        { "include": "#support" },
        { "include": "#keyword" },
        { "include": "#constant" },
        { "include": "#vararg" },
        { "include": "#operator" },
        { "include": "#call" },
        { "include": "#tableLiteral" },
        { "include": "#attribute" },
        { "include": "#identifier" },
        { "include": "#punctuation" }
    ],
    "repository": {
        "directive": {
            "patterns": [
                {
                    "match": "^\\s*(#!)[ \\t]*(strict|nonstrict|nocheck)\\b",
                    "captures": {
                        "1": { "name": "punctuation.definition.directive.luam" },
                        "2": { "name": "keyword.control.directive.strictness.luam" }
                    }
                },
                {
                    "match": "^\\s*(#!)[ \\t]*(server)\\b",
                    "captures": {
                        "1": { "name": "punctuation.definition.directive.luam" },
                        "2": { "name": "keyword.control.directive.environment.server.luam" }
                    }
                },
                {
                    "match": "^\\s*(#!)[ \\t]*(client)\\b",
                    "captures": {
                        "1": { "name": "punctuation.definition.directive.luam" },
                        "2": { "name": "keyword.control.directive.environment.client.luam" }
                    }
                },
                {
                    "match": "^\\s*(#!)[ \\t]*(shared)\\b",
                    "captures": {
                        "1": { "name": "punctuation.definition.directive.luam" },
                        "2": { "name": "keyword.control.directive.environment.shared.luam" }
                    }
                }
            ]
        },
        "decorator": {
            "match": "^\\s*(@)([A-Za-z_][A-Za-z0-9_]*)\\b",
            "captures": {
                "1": { "name": "punctuation.definition.decorator.luam" },
                "2": { "name": "entity.name.function.decorator.luam" }
            }
        },
        "decrement": {
            "name": "keyword.operator.increment.luam",
            "match": "(?<=[A-Za-z0-9_)\\]])--(?=[ \\t]*(?:;|\\}|$))"
        },
        "comment": {
            "patterns": [
                {
                    "name": "comment.block.luam",
                    "begin": "#\\*",
                    "end": "\\*#"
                },
                {
                    "name": "comment.line.number-sign.luam",
                    "begin": "#(?=\\s|!|$)",
                    "end": "$"
                }
            ]
        },
        "string": {
            "patterns": [
                {
                    "name": "string.quoted.other.long.luam",
                    "begin": "\\[(=*)\\[",
                    "end": "\\]\\1\\]"
                },
                {
                    "name": "string.quoted.single.luam",
                    "begin": "'",
                    "end": "'",
                    "patterns": [{ "include": "#escape" }]
                },
                {
                    "name": "string.quoted.double.luam",
                    "begin": "\"",
                    "end": "\"",
                    "patterns": [{ "include": "#escape" }]
                },
                {
                    "name": "string.template.luam",
                    "begin": "`",
                    "end": "`",
                    "patterns": [{ "include": "#interpolation" }, { "include": "#escape" }]
                }
            ]
        },
        "interpolation": {
            "name": "meta.embedded.expression.luam",
            "begin": "\\$\\{",
            "end": "\\}",
            "beginCaptures": { "0": { "name": "punctuation.definition.template-expression.begin.luam" } },
            "endCaptures": { "0": { "name": "punctuation.definition.template-expression.end.luam" } },
            "patterns": [
                {
                    "match": "([A-Za-z_][A-Za-z0-9_.]*)\\s*(?::([^}]*))?",
                    "captures": {
                        "1": { "name": "variable.other.luam" },
                        "2": { "name": "string.unquoted.default.luam" }
                    }
                }
            ]
        },
        "escape": {
            "name": "constant.character.escape.luam",
            "match": "\\\\(?:[abfnrtv\\\\\"'\\n]|x[0-9A-Fa-f]{2}|[0-9]{1,3})"
        },
        "number": {
            "name": "constant.numeric.luam",
            "match": "\\b(?:0[xX][0-9A-Fa-f]+|(?:[0-9]+\\.?[0-9]*|\\.[0-9]+)(?:[eE][-+]?[0-9]+)?)\\b"
        },
        "buildDirective": {
            "patterns": [
                {
                    "match": "\\b(export)\\s+(?:(http)\\s+)?(?=(?:local\\s+)?function\\b)",
                    "captures": {
                        "1": { "name": "storage.modifier.export.luam" },
                        "2": { "name": "storage.modifier.http.luam" }
                    }
                }
            ]
        },
        "enumBody": {
            "begin": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\{)",
            "beginCaptures": {
                "1": { "name": "storage.type.enum.luam" },
                "2": { "name": "entity.name.type.enum.luam" },
                "3": { "name": "punctuation.section.braces.begin.luam" }
            },
            "end": "(\\})",
            "endCaptures": { "1": { "name": "punctuation.section.braces.end.luam" } },
            "patterns": [
                { "include": "#comment" },
                { "include": "#string" },
                { "include": "#number" },
                { "name": "variable.other.enummember.luam", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b" },
                { "include": "#operator" },
                { "include": "#punctuation" }
            ]
        },
        "declaration": {
            "patterns": [
                {
                    "match": "\\b(class)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(extends)\\s+([A-Za-z_][A-Za-z0-9_]*))?",
                    "captures": {
                        "1": { "name": "storage.type.class.luam" },
                        "2": { "name": "entity.name.type.class.luam" },
                        "3": { "name": "storage.modifier.extends.luam" },
                        "4": { "name": "entity.other.inherited-class.luam" }
                    }
                },
                {
                    "match": "\\b(interface)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(extends)\\s+([A-Za-z_][A-Za-z0-9_,\\s]*))?",
                    "captures": {
                        "1": { "name": "storage.type.interface.luam" },
                        "2": { "name": "entity.name.type.interface.luam" },
                        "3": { "name": "storage.modifier.luam" },
                        "4": { "name": "entity.other.inherited-interface.luam" }
                    }
                },
                {
                    "match": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "storage.type.enum.luam" },
                        "2": { "name": "entity.name.type.enum.luam" }
                    }
                },
                {
                    "match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "storage.type.alias.luam" },
                        "2": { "name": "entity.name.type.alias.luam" }
                    }
                },
                {
                    "match": "\\b(implements)\\s+([A-Za-z_][A-Za-z0-9_,\\s]*)",
                    "captures": {
                        "1": { "name": "storage.modifier.luam" },
                        "2": { "name": "entity.other.inherited-interface.luam" }
                    }
                },
                {
                    "match": "\\b(new)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": { "name": "keyword.operator.new.luam" },
                        "2": { "name": "entity.name.function.constructor.luam" }
                    }
                }
            ]
        },
        "field": {
            "match": "^[ \\t]*([A-Za-z_][A-Za-z0-9_]*)[ \\t]*(?=\\??[ \\t]*:[ \\t]*(?:fun[ \\t]*\\([^)]*\\)[ \\t]*:[ \\t]*)?[A-Za-z_][A-Za-z0-9_.]*(?:<[^>]*>)?(?:\\[\\])*\\??(?:[ \\t]*[|&][ \\t]*[A-Za-z_][A-Za-z0-9_.]*(?:\\[\\])*\\??)*[ \\t]*(?:=[^=]|$))",
            "captures": { "1": { "name": "variable.other.property.luam" } }
        },
        "function": {
            "patterns": [
                {
                    "begin": "\\b(function)\\s*([A-Za-z_][A-Za-z0-9_]*(?:[.:][A-Za-z_][A-Za-z0-9_]*)*)?\\s*(\\()",
                    "beginCaptures": {
                        "1": { "name": "storage.type.function.luam" },
                        "2": { "name": "entity.name.function.luam" },
                        "3": { "name": "punctuation.section.parens.begin.luam" }
                    },
                    "end": "(\\))",
                    "endCaptures": { "1": { "name": "punctuation.section.parens.end.luam" } },
                    "patterns": [{ "include": "#parameterList" }]
                },
                {
                    "match": "\\b(function)\\s+([A-Za-z_][A-Za-z0-9_]*(?:[.:][A-Za-z_][A-Za-z0-9_]*)*)?",
                    "captures": {
                        "1": { "name": "storage.type.function.luam" },
                        "2": { "name": "entity.name.function.luam" }
                    }
                },
                {
                    "match": "\\b(?!constructor\\b)([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*=\\s*function\\b)",
                    "captures": {
                        "1": { "name": "entity.name.function.luam" }
                    }
                }
            ]
        },
        "parameterList": {
            "patterns": [
                { "include": "#comment" },
                { "include": "#annotation" },
                { "include": "#vararg" },
                { "include": "#string" },
                { "include": "#number" },
                { "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b", "captures": { "1": { "name": "variable.parameter.luam" } } },
                { "include": "#operator" },
                { "include": "#punctuation" }
            ]
        },
        "method": {
            "match": "(:)\\s*(?!fun\\b)([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*[({'\"`]|\\s*\\[\\[)",
            "captures": {
                "1": { "name": "punctuation.accessor.luam" },
                "2": { "name": "entity.name.function.method.luam" }
            }
        },
        "support": {
            "patterns": [
                {
                    "name": "support.function.library.luam",
                    "match": "(?<![^.]\\.|:)\\b(?:coroutine|debug|io|math|os|string|table|utf8)\\.[A-Za-z_][A-Za-z0-9_]*\\b"
                },
                {
                    "name": "support.function.luam",
                    "match": "(?<![^.]\\.|:)\\b(?:assert|collectgarbage|dofile|error|getmetatable|ipairs|load|loadstring|next|pairs|pcall|print|rawequal|rawget|rawlen|rawset|require|select|setmetatable|tonumber|tostring|type|unpack|xpcall)\\b(?=\\s*[({'\"`])"
                }
            ]
        },
        "annotation": {
            "patterns": [
                {
                    "match": "(:)\\s*(?=\\{)",
                    "captures": {
                        "1": { "name": "punctuation.separator.type.luam" }
                    }
                },
                {
                    "match": "(:)\\s*((?:fun\\s*\\([^)]*\\)\\s*:\\s*)?[A-Za-z_][A-Za-z0-9_.]*(?:<[^>]*>)?(?:\\[\\])*\\??(?:\\s*[|&]\\s*[A-Za-z_][A-Za-z0-9_.]*(?:\\[\\])*\\??)*)",
                    "captures": {
                        "1": { "name": "punctuation.separator.type.luam" },
                        "2": { "name": "meta.type.luam", "patterns": [{ "include": "#typeBody" }] }
                    }
                }
            ]
        },
        "typeBody": {
            "patterns": [
                { "name": "storage.type.fun.luam", "match": "\\bfun\\b" },
                { "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b(?=\\s*\\??\\s*:)", "captures": { "1": { "name": "variable.parameter.luam" } } },
                {
                    "name": "support.type.primitive.luam",
                    "match": "\\b(?:any|boolean|number|string|table|thread|unknown|userdata|void)\\b"
                },
                { "name": "entity.name.type.luam", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b" },
                { "name": "punctuation.definition.array.luam", "match": "\\[\\]" },
                { "name": "keyword.operator.type.luam", "match": "[|&]" },
                { "name": "punctuation.definition.typeparameters.begin.luam", "match": "<" },
                { "name": "punctuation.definition.typeparameters.end.luam", "match": ">" },
                { "name": "keyword.operator.optional.luam", "match": "\\?" },
                { "name": "punctuation.separator.type.luam", "match": ":" },
                { "include": "#punctuation" }
            ]
        },
        "keyword": {
            "patterns": [
                {
                    "name": "keyword.control.luam",
                    "match": "\\b(?:break|continue|do|else|elseif|end|for|if|in|repeat|return|then|until|while)\\b"
                },
                {
                    "name": "storage.type.function.luam",
                    "match": "\\bfunction\\b"
                },
                {
                    "name": "keyword.local.luam",
                    "match": "\\b(?:local)\\b"
                },
                {
                    "name": "storage.modifier.luam",
                    "match": "\\b(?:extends|implements)\\b"
                },
                {
                    "name": "storage.type.constructor.luam",
                    "match": "\\bconstructor\\b"
                },
                {
                    "name": "storage.type.declare.luam",
                    "match": "\\bdeclare\\b"
                },
                {
                    "name": "storage.modifier.export.luam",
                    "match": "\\bexport\\b"
                },
                {
                    "name": "storage.type.class.luam",
                    "match": "\\bclass\\b"
                },
                {
                    "name": "storage.type.interface.luam",
                    "match": "\\binterface\\b"
                },
                {
                    "name": "storage.type.enum.luam",
                    "match": "\\benum\\b"
                },
                {
                    "name": "storage.type.alias.luam",
                    "match": "\\btype\\b(?=\\s+[A-Za-z_])"
                },
                {
                    "name": "keyword.operator.new.luam",
                    "match": "\\bnew\\b"
                },
                {
                    "name": "variable.language.self.luam",
                    "match": "\\b(?:self|super)\\b"
                }
            ]
        },
        "vararg": {
            "name": "variable.language.vararg.luam",
            "match": "\\.\\.\\."
        },
        "constant": {
            "patterns": [
                { "include": "#vararg" },
                { "name": "constant.language.luam", "match": "\\b(?:true|false|nil)\\b" },
                {
                    "name": "support.type.primitive.luam",
                    "match": "\\b(?:any|boolean|number|string|table|thread|unknown|userdata|void)\\b"
                }
            ]
        },
        "operator": {
            "patterns": [
                { "name": "keyword.operator.logical.luam", "match": "\\b(?:and|or|not)\\b" },
                { "name": "keyword.operator.increment.luam", "match": "\\+\\+" },
                { "name": "keyword.operator.optional.luam", "match": "\\?(?=\\s*:)" },
                { "name": "keyword.operator.type.luam", "match": "[|&]" },
                { "name": "keyword.operator.comparison.luam", "match": "==|~=|<=|>=|<|>" },
                { "name": "keyword.operator.assignment.luam", "match": "\\.\\.=|\\+=|-=|\\*=|/=|=" },
                { "name": "keyword.operator.arithmetic.luam", "match": "\\+|-|\\*|/|%|\\^|#|\\.\\." }
            ]
        },
        "call": {
            "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
            "captures": { "1": { "name": "entity.name.function.call.luam" } }
        },
        "tableLiteral": {
            "begin": "\\{",
            "end": "\\}",
            "beginCaptures": { "0": { "name": "punctuation.section.braces.begin.luam" } },
            "endCaptures": { "0": { "name": "punctuation.section.braces.end.luam" } },
            "patterns": [
                { "include": "#decorator" },
                { "include": "#comment" },
                { "include": "#string" },
                { "include": "#number" },
                { "include": "#declaration" },
                { "include": "#field" },
                { "include": "#function" },
                { "include": "#method" },
                { "include": "#annotation" },
                { "include": "#attribute" },
                {
                    "match": "\\b(?!constructor\\b)([A-Za-z_][A-Za-z0-9_]*)\\s*(?==[^=])",
                    "captures": { "1": { "name": "meta.object-literal.key.luam" } }
                },
                { "include": "#support" },
                { "include": "#keyword" },
                { "include": "#constant" },
                { "include": "#operator" },
                { "include": "#call" },
                { "include": "#tableLiteral" },
                { "include": "#attribute" },
                { "include": "#identifier" },
                { "include": "#punctuation" }
            ]
        },
        "attribute": {
            "name": "entity.other.attribute.luam",
            "match": "(?<=[^.]\\.)\\b[A-Za-z_][A-Za-z0-9_]*\\b(?!\\s*=\\s*function\\b)"
        },
        "identifier": {
            "name": "variable.other.luam",
            "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        },
        "punctuation": {
            "patterns": [
                { "name": "punctuation.section.parens.begin.luam", "match": "\\(" },
                { "name": "punctuation.section.parens.end.luam", "match": "\\)" },
                { "name": "punctuation.section.brackets.begin.luam", "match": "\\[" },
                { "name": "punctuation.section.brackets.end.luam", "match": "\\]" },
                { "name": "punctuation.section.braces.begin.luam", "match": "\\{" },
                { "name": "punctuation.section.braces.end.luam", "match": "\\}" },
                { "name": "punctuation.separator.comma.luam", "match": "," },
                { "name": "punctuation.terminator.statement.luam", "match": ";" },
                { "name": "punctuation.accessor.luam", "match": "[.:]" }
            ]
        }
    }
}
