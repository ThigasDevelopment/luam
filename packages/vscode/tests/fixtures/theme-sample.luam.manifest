# The resource manifest.
{
    info = {
        version = '1.0.0',
        description = `Built in ${mode} from ${root}`,
    },

    environment = {
        oop = false,
        strict = true,

        version = { server = '1.6.0', client = '1.6.0' },
    },

    scripts = {
        { path = 'src/shared/**/*.luam', type = 'shared' },

        { path = 'src/server/**/*.luam', type = 'server' },
        { path = 'src/client/**/*.luam', type = 'client' },
    },

    build = {
        output = 'build',

        details = { bundle = true, minify = false, map = nil },
    },
}
