{
    "name": "luam",
    "displayName": "Luam",
    "icon": "icon.png",
    "description": "Language support for Luam, a typed Lua that compiles to Multi Theft Auto resources.",
    "version": "0.17.0",
    "private": true,
    "type": "module",
    "main": "./dist/extension.cjs",
    "publisher": "luam",
    "license": "MIT",
    "homepage": "https://github.com/ThigasDevelopment/luam#readme",
    "bugs": {
        "url": "https://github.com/ThigasDevelopment/luam/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ThigasDevelopment/luam.git"
    },
    "engines": {
        "vscode": "^1.82.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "keywords": [
        "mta",
        "multi theft auto",
        "lua",
        "luam",
        "typed lua"
    ],
    "activationEvents": [
        "workspaceContains:**/*.luam",
        "workspaceContains:.luam.manifest"
    ],
    "contributes": {
        "languages": [
            {
                "id": "luam",
                "aliases": [
                    "Luam",
                    "luam"
                ],
                "extensions": [
                    ".luam"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./icons/luam-file-light.svg",
                    "dark": "./icons/luam-file-dark.svg"
                }
            },
            {
                "id": "luam-manifest",
                "aliases": [
                    "Luam Manifest"
                ],
                "filenames": [
                    ".luam.manifest"
                ],
                "extensions": [
                    ".luam.manifest"
                ],
                "configuration": "./manifest-language-configuration.json",
                "icon": {
                    "light": "./icons/luam-manifest-light.svg",
                    "dark": "./icons/luam-manifest-dark.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "luam",
                "scopeName": "source.luam",
                "path": "./syntaxes/luam.tmLanguage.json"
            },
            {
                "language": "luam-manifest",
                "scopeName": "source.luam-manifest",
                "path": "./syntaxes/luam-manifest.tmLanguage.json"
            }
        ],
        "commands": [
            {
                "command": "luam.build",
                "title": "Luam: Build",
                "category": "Luam",
                "icon": "$(play)"
            },
            {
                "command": "luam.ensure",
                "title": "Luam: Ensure Resource",
                "category": "Luam"
            },
            {
                "command": "luam.restartServer",
                "title": "Luam: Restart Language Server",
                "category": "Luam"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "luam.build",
                    "when": "editorLangId == luam",
                    "group": "navigation"
                }
            ]
        },
        "keybindings": [
            {
                "command": "luam.ensure",
                "key": "ctrl+alt+e",
                "mac": "cmd+alt+e",
                "when": "editorLangId == luam"
            }
        ],
        "configuration": {
            "title": "Luam",
            "properties": {
                "luam.cliPath": {
                    "type": "string",
                    "default": "luam",
                    "description": "Command used to run the Luam CLI."
                },
                "luam.ensureWatch": {
                    "type": "boolean",
                    "default": true,
                    "description": "Pass --watch when the ensure command runs."
                },
                "luam.trace.server": {
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Trace the communication with the Luam language server."
                }
            }
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "bundle": "node scripts/bundle.ts",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@luam/lsp": "workspace:*",
        "vscode-languageclient": "^9.0.1"
    },
    "devDependencies": {
        "@types/node": "^22.9.0",
        "@types/vscode": "^1.82.0",
        "esbuild": "^0.21.5",
        "typescript": "^5.6.3",
        "vitest": "^2.1.4"
    }
}
