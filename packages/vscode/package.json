{
    "name": "luam",
    "displayName": "Luam",
    "icon": "icon.png",
    "description": "Language support for Luam, a typed Lua that compiles to Multi Theft Auto resources.",
    "version": "0.19.3",
    "private": true,
    "type": "module",
    "main": "./dist/extension.cjs",
    "publisher": "luam",
    "license": "MIT",
    "homepage": "https://github.com/ThigasDevelopment/luam#readme",
    "bugs": {
        "url": "https://github.com/ThigasDevelopment/luam/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ThigasDevelopment/luam.git"
    },
    "engines": {
        "vscode": "^1.82.0"
    },
    "categories": [
        "Programming Languages",
        "Themes"
    ],
    "keywords": [
        "mta",
        "multi theft auto",
        "lua",
        "luam",
        "typed lua"
    ],
    "activationEvents": [
        "workspaceContains:**/*.luam",
        "workspaceContains:.luam.manifest"
    ],
    "contributes": {
        "languages": [
            {
                "id": "luam",
                "aliases": [
                    "Luam",
                    "luam"
                ],
                "extensions": [
                    ".luam"
                ],
                "configuration": "./language-configuration.json",
                "icon": {
                    "light": "./icons/luam-file-light.svg",
                    "dark": "./icons/luam-file-dark.svg"
                }
            },
            {
                "id": "luam-manifest",
                "aliases": [
                    "Luam Manifest"
                ],
                "filenames": [
                    ".luam.manifest"
                ],
                "extensions": [
                    ".luam.manifest"
                ],
                "configuration": "./manifest-language-configuration.json",
                "icon": {
                    "light": "./icons/luam-manifest-light.svg",
                    "dark": "./icons/luam-manifest-dark.svg"
                }
            }
        ],
        "grammars": [
            {
                "language": "luam",
                "scopeName": "source.luam",
                "path": "./syntaxes/luam.tmLanguage.json"
            },
            {
                "language": "luam-manifest",
                "scopeName": "source.luam-manifest",
                "path": "./syntaxes/luam-manifest.tmLanguage.json"
            }
        ],
        "commands": [
            {
                "command": "luam.build",
                "title": "Luam: Build",
                "category": "Luam",
                "icon": "$(play)"
            },
            {
                "command": "luam.ensure",
                "title": "Luam: Ensure Resource",
                "category": "Luam"
            },
            {
                "command": "luam.restartServer",
                "title": "Luam: Restart Language Server",
                "category": "Luam"
            },
            {
                "command": "luam.rescanWorkspace",
                "title": "Luam: Rescan Workspace",
                "category": "Luam"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "luam.build",
                    "when": "editorLangId == luam",
                    "group": "navigation"
                }
            ]
        },
        "keybindings": [
            {
                "command": "luam.ensure",
                "key": "ctrl+alt+e",
                "mac": "cmd+alt+e",
                "when": "editorLangId == luam"
            }
        ],
        "configuration": {
            "title": "Luam",
            "properties": {
                "luam.cliPath": {
                    "type": "string",
                    "default": "luam",
                    "description": "Command used to run the Luam CLI."
                },
                "luam.ensureWatch": {
                    "type": "boolean",
                    "default": true,
                    "description": "Pass --watch when the ensure command runs."
                },
                "luam.formatting": {
                    "type": "boolean",
                    "default": true,
                    "description": "Format .luam files with the Luam language server. Turn it off to leave formatting to another tool, or to none."
                },
                "luam.trace.server": {
                    "type": "string",
                    "enum": [
                        "off",
                        "messages",
                        "verbose"
                    ],
                    "default": "off",
                    "description": "Trace the communication with the Luam language server."
                },
                "luam.semanticHighlighting": {
                    "type": "boolean",
                    "default": true,
                    "description": "Colours Luam with the semantic tokens the language server serves."
                }
            }
        },
        "themes": [
            {
                "label": "Luam Dark",
                "uiTheme": "vs-dark",
                "path": "./themes/luam-dark.json"
            },
            {
                "label": "Luam Light",
                "uiTheme": "vs",
                "path": "./themes/luam-light.json"
            }
        ],
        "semanticTokenScopes": [
            {
                "language": "luam",
                "scopes": {
                    "*.generated": [
                        "entity.name.function.luam"
                    ],
                    "function.defaultLibrary.mtaNative.serverOnly": [
                        "entity.name.function.call.luam"
                    ],
                    "function.defaultLibrary.mtaNative.clientOnly": [
                        "entity.name.function.call.luam"
                    ],
                    "function.defaultLibrary.mtaNative": [
                        "entity.name.function.call.luam"
                    ],
                    "variable.defaultLibrary.mtaNative.serverOnly": [
                        "entity.name.function.call.luam"
                    ],
                    "variable.defaultLibrary.mtaNative.clientOnly": [
                        "entity.name.function.call.luam"
                    ],
                    "variable.defaultLibrary.mtaNative": [
                        "entity.name.function.call.luam"
                    ],
                    "type.defaultLibrary.erased": [
                        "support.type.primitive.luam"
                    ],
                    "function.defaultLibrary": [
                        "support.function.library.luam"
                    ],
                    "variable.defaultLibrary": [
                        "support.function.library.luam"
                    ],
                    "class.declaration": [
                        "entity.name.type.class.luam"
                    ],
                    "interface.declaration": [
                        "entity.name.type.class.luam"
                    ],
                    "enum.declaration": [
                        "entity.name.type.class.luam"
                    ],
                    "type.declaration": [
                        "entity.name.type.class.luam"
                    ],
                    "enumMember.declaration": [
                        "entity.other.attribute.luam"
                    ],
                    "class.erased": [
                        "entity.name.type.luam"
                    ],
                    "enum.erased": [
                        "entity.name.type.luam"
                    ],
                    "decorator": [
                        "entity.name.function.decorator.luam"
                    ],
                    "event": [
                        "string.quoted.single.luam"
                    ],
                    "class": [
                        "entity.name.function.constructor.luam"
                    ],
                    "interface": [
                        "entity.name.type.luam"
                    ],
                    "enum": [
                        "variable.other.luam"
                    ],
                    "type": [
                        "entity.name.type.luam"
                    ],
                    "function": [
                        "entity.name.function.call.luam"
                    ],
                    "method": [
                        "entity.name.function.method.luam"
                    ],
                    "parameter": [
                        "variable.parameter.luam"
                    ],
                    "variable": [
                        "variable.other.luam"
                    ],
                    "property": [
                        "entity.other.attribute.luam"
                    ],
                    "enumMember": [
                        "entity.other.attribute.luam"
                    ]
                }
            }
        ],
        "configurationDefaults": {
            "[luam]": {
                "editor.defaultFormatter": "luam.luam",
                "editor.insertSpaces": true,
                "editor.tabSize": 4
            }
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "bundle": "node ../theme/scripts/build-theme.ts && node scripts/bundle.ts",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@luam/lsp": "workspace:*",
        "vscode-languageclient": "^9.0.1"
    },
    "devDependencies": {
        "@luam/theme": "workspace:*",
        "@types/node": "^22.9.0",
        "@types/vscode": "^1.82.0",
        "esbuild": "^0.21.5",
        "typescript": "^5.6.3",
        "vitest": "^2.1.4",
        "vscode-oniguruma": "^2.0.1",
        "vscode-textmate": "^9.3.2"
    }
}
