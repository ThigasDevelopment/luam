name = 'luam-demo'
author = 'Thigas'
version = '1.0.0'
description = 'A Luam resource showing the layout luam init scaffolds.'

compiler = {
    strict = true,
    oop = false,
}

sources = {
    server = { 'src/server/**/*.luam' },
    client = { 'src/client/**/*.luam' },
    shared = { 'src/shared/**/*.luam' },
}

assets = {
    { from = 'assets/**/*', to = 'assets' },
}

dependencies = { 'scoreboard', 'admin' }

engine = { minVersion = '1.6.0' }

output = {
    bundle = false,
    map = true,
}

outDir = 'build'
