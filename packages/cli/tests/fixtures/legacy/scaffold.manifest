name = 'luam-demo'
version = '1.0.0'
description = 'A Luam resource scaffolded by luam init.'

compiler = {
    strict = true,
    oop = false,
}

sources = {
    server = { 'src/server/**/*.luam' },
    client = { 'src/client/**/*.luam' },
    shared = { 'src/shared/**/*.luam' },
}

outDir = 'build'
