{
    info = {
        version = '1.0.0',
        description = 'A Luam resource showing the layout luam init scaffolds.',
    },

    environment = {
        oop = false,
        strict = true,
    },

    scripts = {
        { path = 'src/shared/**/*.luam', type = 'shared' },

        { path = 'src/server/**/*.luam', type = 'server' },
        { path = 'src/client/**/*.luam', type = 'client' },
    },

    # files = {
    #     'assets/**/*.png',
    # },

    build = {
        output = 'build',
    },
}
