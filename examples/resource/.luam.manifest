name = 'luam-resource'
version = '1.0.0'
description = 'A Luam resource showing the layout luam init scaffolds.'

compilerOptions = {
    strict = true,
    oop = false,
}

sources = {
    server = { 'src/server/**/*.luam' },
    client = { 'src/client/**/*.luam' },
    shared = { 'src/shared/**/*.luam' },
}

assets = {
    { from = 'assets/**/*', to = 'assets' },
}

outDir = 'build'

transport = {
    kind = 'none',
}
