class Event {
    name: string = ''
    element: any = nil
    handler: any = nil
    attached: boolean = false

    constructor = function (name: string, element: any, handler: any)
        self.name = name
        self.element = element
        self.handler = handler
        self.attached = false
    end

    attach = function (): boolean
        if self.attached then
            return false
        end

        self.attached = addEventHandler(self.name, self.element, self.handler)

        return self.attached
    end

    detach = function (): boolean
        if not self.attached then
            return false
        end

        removeEventHandler(self.name, self.element, self.handler)

        self.attached = false

        return true
    end

    describe = function (): string
        return self.name
    end
}
