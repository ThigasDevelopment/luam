class ThreadPool {
    pool: any = nil

    constructor = function (style: string, priority: string)
        self.pool = new Threads(style, priority)
    end

    add = function (task: any): number
        return self.pool:add(task, {})
    end

    remove = function (id: number): boolean
        return self.pool:remove(id)
    end

    clear = function (): boolean
        return self.pool:clear()
    end

    priority = function (): string
        return self.pool:getPriority()
    end

    setPriority = function (priority: string): boolean
        return self.pool:setPriority(priority)
    end
}
