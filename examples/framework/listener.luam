class Listener {
    core: any = nil
    event: string = ''
    element: any = nil
    binding: any = nil

    constructor = function (core: any)
        self.core = core
        self.binding = nil
    end

    target = function (): any
        if self.element == nil then
            return root
        end

        return self.element
    end

    handle = function (...): void
    end

    register = function (): boolean
        if self.event == '' then
            return false
        end

        self.binding = new Event(self.event, self:target(), bind(self.handle, self))

        return self.binding:attach()
    end

    unregister = function (): boolean
        if self.binding == nil then
            return false
        end

        return self.binding:detach()
    end
}
