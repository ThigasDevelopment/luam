class Core {
    side: string = 'shared'
    listeners: any = nil
    commands: any = nil
    started: boolean = false

    constructor = function (side: string)
        self.side = side
        self.listeners = {}
        self.commands = {}
        self.started = false
    end

    isServer = function (): boolean
        return self.side == 'server'
    end

    isClient = function (): boolean
        return self.side == 'client'
    end

    log = function (message: string): void
        outputDebugString('[' .. self.side .. '] ' .. message)
    end

    start = function (): boolean
        if self.started then
            return false
        end

        self.started = true

        local loader: Loader = new Loader(self)

        self.listeners = loader:loadListeners()
        self.commands = loader:loadCommands()

        self:log('loaded ' .. #self.listeners .. ' listener(s) and ' .. #self.commands .. ' command(s)')

        return true
    end

    stop = function (): boolean
        if not self.started then
            return false
        end

        for index = 1, #self.listeners do
            self.listeners[index]:unregister()
        end

        self.listeners = {}
        self.commands = {}
        self.started = false

        return true
    end
}
