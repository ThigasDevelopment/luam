#* The untyped escape hatch ADR-045 records: getClasses() and getClass() build
   the same set by reflection, for the case where the class set genuinely is
   not known when the code is written. Every value below is "any" — the
   constructor arity is unchecked and so is the constructed type. Prefer
   registry.luam, which lists the classes once and keeps all of that. *#

class Loader {
    core: any = nil

    constructor = function (core: any)
        self.core = core
    end

    inherits = function (definition: any, baseName: string): boolean
        local current: any = definition

        while current ~= nil do
            local parent: any = rawget(current, '__super')

            if parent == nil then
                return false
            end

            if rawget(parent, '__name') == baseName then
                return true
            end

            current = parent
        end

        return false
    end

    subclasses = function (baseName: string): string[]
        local found: string[] = {}
        local definitions: table = getClasses()

        for name, definition in pairs(definitions) do
            if self:inherits(definition, baseName) then
                table.insert(found, name)
            end
        end

        table.sort(found)

        return found
    end

    instantiate = function (baseName: string): any
        local created: any = {}
        local names: string[] = self:subclasses(baseName)

        for index = 1, #names do
            local definition: any = getClass(names[index])
            local instance: any = setmetatable({}, { __index = definition })

            if type(instance.constructor) == 'function' then
                instance:constructor(self.core)
            end

            table.insert(created, instance)
        end

        return created
    end

    loadListeners = function (): any
        local listeners: any = self:instantiate('Listener')

        for index = 1, #listeners do
            listeners[index]:register()
        end

        return listeners
    end

    loadCommands = function (): any
        local commands: any = self:instantiate('Command')

        for index = 1, #commands do
            commands[index]:register()
        end

        return commands
    end
}
