{
    info = {
        description = 'A resource that compiles an installed Luam library into its output.',
    },

    environment = {
        libraries = {
            '@luam-example/collections',
        },
    },

    scripts = {
        { path = 'src/shared/**/*.luam', type = 'shared' },

        { path = 'src/server/**/*.luam', type = 'server' },
        { path = 'src/client/**/*.luam', type = 'client' },
    },
}
