{
    info = {
        description = 'The MTA OOP API enabled through the oop compiler option.',
    },

    environment = {
        oop = true,
    },

    scripts = {
        { path = 'src/shared/**/*.luam', type = 'shared' },

        { path = 'src/server/**/*.luam', type = 'server' },
        { path = 'src/client/**/*.luam', type = 'client' },
    },
}
