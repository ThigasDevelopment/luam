local MAX_HEALTH: number = 100

local function heal(player: Player, command: string, amount?: string): void
    local requested: any = tonumber(amount) or MAX_HEALTH
    local current: number = getElementHealth(player)
    local target: number = current + requested
    local healed: number = target.clamp(0, MAX_HEALTH)

    setElementHealth(player, healed)

    outputChatBox(`Healed from ${current} to ${healed} HP.`, player)
end

addCommandHandler('heal', heal)
